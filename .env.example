# Copier ce fichier en .env et remplir les valeurs réelles.
# Ne jamais committer le fichier .env (voir .gitignore).

ENV=development

# URL de connexion Supabase (Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

SECRET_KEY=change-me-in-production

# Règles métier par défaut (paramétrables, voir Settings dans l'app)
DAILY_HOURS=8
WEEKLY_HOURS=40
WORKING_DAYS=5
INTERVAL_MINUTES=30
